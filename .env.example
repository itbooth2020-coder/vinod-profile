# Copy to .env and add your key from https://platform.claude.com/ to enable the live profile agent.
# Without it, the prompt console answers from the bundled resume data instead.
ANTHROPIC_API_KEY=

# VINCE's voice: add an ElevenLabs key from https://elevenlabs.io/app/settings/api-keys
# (it needs the Text to Speech permission). Without it, VINCE uses the browser's built-in voice.
ELEVENLABS_API_KEY=
# Optional: another voice (default George; Daniel = onwK4e9ZLuTAKqWW03F9), model and daily cap.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_DAILY_CHAR_LIMIT=10000
