# Copy to .env and add your key from https://platform.claude.com/ to enable the live profile agent.
# Without it, the prompt console answers from the bundled resume data instead.
ANTHROPIC_API_KEY=

# VINCE's voice is free: open-source Kokoro text-to-speech running on this server (no key needed).
# The model (~160 MB) downloads on first start. All settings are optional:
# VINCE_VOICE=off          # use the browser's built-in voice instead
# KOKORO_VOICE=bm_george   # British male; bm_fable is a lighter alternative
# KOKORO_DTYPE=fp16
# KOKORO_SPEED=1.0
