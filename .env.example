# Copy to .env and add your key from https://platform.claude.com/ to enable the live profile agent.
# Without it, the prompt console answers from the bundled resume data instead.
ANTHROPIC_API_KEY=

# Spend control: also set a monthly spend limit on the key's workspace in the Anthropic Console
# (workspace limits), so a bug or abuse can never cost more than you chose. The settings below
# limit use per server; the console limit caps the bill.

# Live agent (server/profileAgent.js), all optional:
# PROFILE_AGENT_MODEL=claude-sonnet-5-5        # default; short answers grounded in a 3-page resume
#                                              # (claude-opus-5-5 costs about twice as much per token)
# PROFILE_AGENT_VOICE_MODEL=claude-sonnet-5-5  # VINCE's spoken answers; defaults to PROFILE_AGENT_MODEL
# PROFILE_AGENT_DAILY_LIMIT=300                # questions per UTC day for the whole server, then 429
# PROFILE_AGENT_ORIGINS=https://www.vinodyadav.com,https://vinodyadav.com
#                                              # pages allowed to ask; default: those two and http://localhost
# PROFILE_AGENT_SECRET=                        # signs answers sent back as history; random per start if unset
# TRUST_PROXY=true                             # only behind a proxy you control that sets X-Forwarded-For;
#                                              # behind CloudFront, CloudFront-Viewer-Address is used instead

# VINCE's voice is free: open-source Kokoro text-to-speech running on this server (no key needed).
# The model (~310 MB at fp32) downloads on first start. All settings are optional:
# VINCE_VOICE=off          # use the browser's built-in voice instead
# KOKORO_VOICE=bm_george   # British male; bm_fable is a lighter alternative
# KOKORO_DTYPE=fp32        # default; fp16 is smaller but can produce silent (NaN) audio on CPU
# KOKORO_SPEED=1.0

# VITE_LIVE_AGENT=true     # build-time: production builds call /api/ask and /api/speak only when 'true' (dev tries them unless 'false'); leave unset for the static S3 + CloudFront site
