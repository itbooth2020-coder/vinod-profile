# Private inputs (SEC-009): any resume or other PDF, whatever its name, stays local. The site ships
# no PDFs (scripts/check-dist.mjs fails the build on one); to publish one on purpose, add a
# negation such as !public/<file>.pdf here.
*.pdf
server/linkedin.md
server/*.local.*
src/availability.local.js

